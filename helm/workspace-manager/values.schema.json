{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "affinity": {
            "type": "object",
            "description": "Affinity.",
            "additionalProperties": true
        },
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "extraArgs": {
            "type": "array",
            "description": "Extra container arguments."
        },
        "extraEnv": {
            "type": "array",
            "description": "Extra environment variables.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    },
                    "valueFrom": {
                        "type": "object",
                        "additionalProperties": true
                    }
                }
            }
        },
        "fullnameOverride": {
            "type": "string",
            "description": "Override the fully qualified release name."
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": "object",
            "additionalProperties": true
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "pullPolicy": {
                    "type": "string",
                    "description": "Image pull policy."
                },
                "registry": {
                    "type": "string",
                    "description": "Image registry."
                },
                "repository": {
                    "type": "string",
                    "description": "Image repository."
                },
                "tag": {
                    "type": "string",
                    "description": "Image tag. Defaults to the chart appVersion."
                }
            }
        },
        "imagePullSecrets": {
            "type": "array",
            "description": "Image pull secrets.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string"
                    }
                }
            }
        },
        "logging": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "verbose": {
                    "type": "boolean",
                    "description": "Enable debug logging."
                }
            }
        },
        "mcp": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "path": {
                    "type": "string",
                    "description": "MCP endpoint path."
                }
            }
        },
        "nameOverride": {
            "type": "string",
            "description": "Override the chart name."
        },
        "networkPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowInternet": {
                    "type": "boolean",
                    "description": "Allow egress on 443 to every destination: Dex (discovery and JWKS). Vanilla NetworkPolicy cannot select by name; narrow with egressCIDRs instead when the addresses are known."
                },
                "allowKubeAPI": {
                    "type": "boolean",
                    "description": "Allow egress to the Kubernetes API server."
                },
                "egressCIDRs": {
                    "type": "array",
                    "description": "Extra egress CIDRs."
                },
                "enabled": {
                    "type": "boolean",
                    "description": "Create a Kubernetes NetworkPolicy for the pod (off when an umbrella chart renders the policies)."
                },
                "ingressNamespaces": {
                    "type": "array",
                    "description": "Namespaces allowed to reach the MCP endpoint (label kubernetes.io/metadata.name). Empty allows ingress from the release namespace only."
                },
                "metricsNamespaces": {
                    "type": "array",
                    "description": "Namespaces allowed to scrape the metrics port (label kubernetes.io/metadata.name), when `observability.metrics.enabled`.",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "nodeSelector": {
            "type": "object",
            "description": "Node selector.",
            "additionalProperties": true
        },
        "oauth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowPublicClientRegistration": {
                    "type": "boolean",
                    "description": "Accept unauthenticated dynamic client registration (labs only)."
                },
                "baseURL": {
                    "type": "string",
                    "description": "Public base URL of this server: the issuer of its own OAuth metadata (https, or http on loopback). Empty derives `https://<fullname>.<global.domain>` when `global.domain` is set."
                },
                "dex": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "allowPrivateURLs": {
                            "type": "boolean",
                            "description": "Let the issuer resolve to a private or loopback address (an in-cluster Dex)."
                        },
                        "caSecret": {
                            "type": "object",
                            "description": "Secret with the CA of a Dex that serves a private certificate; `global.identity.ca.secretName` / `global.identity.ca.key`.",
                            "additionalProperties": false,
                            "properties": {
                                "key": {
                                    "type": "string"
                                },
                                "name": {
                                    "type": "string"
                                }
                            }
                        },
                        "clientID": {
                            "type": "string",
                            "description": "Dex OAuth client ID. Empty falls back to `global.identity.clientId`."
                        },
                        "clientSecret": {
                            "type": "string",
                            "description": "Dex OAuth client secret (prefer `oauth.existingSecret`)."
                        },
                        "issuerURL": {
                            "type": "string",
                            "description": "Dex issuer URL. Empty falls back to `global.identity.issuerUrl`."
                        }
                    }
                },
                "enabled": {
                    "type": "boolean",
                    "description": "Make workspace-manager an OAuth 2.1 resource server (mcp-oauth): the MCP endpoint requires a bearer token Dex issued, and every call carries the caller's identity and Dex token, which every Kubernetes call of the request presents. muster forwards the session's Dex id_token (its MCPServer registration with `auth.forwardToken`, unpinned like every manager); it is validated against Dex's JWKS when its audience is in `trustedAudiences`. Off: no caller, so nothing that reaches Kubernetes works; only for a server nothing but a trusted proxy can reach."
                },
                "existingSecret": {
                    "type": "string",
                    "description": "Existing Secret with the Dex client secret under `dex-client-secret`. Empty falls back to `global.identity.existingSecret`; without that, the chart renders a Secret from `oauth.dex.clientSecret`."
                },
                "sso": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "allowPrivateIPs": {
                            "type": "boolean",
                            "description": "Let Dex's JWKS endpoint resolve to a private address when validating forwarded tokens (an in-cluster Dex)."
                        }
                    }
                },
                "trustedAudiences": {
                    "type": "array",
                    "description": "OAuth client IDs whose Dex id_tokens are accepted as bearer tokens: the platform client and the audiences muster requires at login (what the kube-apiserver trusts). Empty falls back to `[global.identity.clientId]`."
                }
            }
        },
        "observability": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "metrics": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Serve Prometheus metrics on `GET /metrics` of the `metrics` port: `mcp_server_operation_duration_seconds` per tool and `http_server_request_duration_seconds` for the MCP endpoint. Off, `OTEL_METRICS_EXPORTER=none`: nothing is served."
                        },
                        "port": {
                            "type": "integer",
                            "description": "Port of the metrics listener, apart from the MCP port so the OAuth guard never covers it."
                        }
                    }
                },
                "otel": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "endpoint": {
                            "type": "string",
                            "description": "OTLP collector URL for traces, e.g. `http://otlp-gateway.kube-system.svc:4317` (gRPC) or `https://tempo.example.com:4318` (with protocol `http/protobuf`). Empty exports nothing; inbound `traceparent` headers still propagate. With `networkPolicy.enabled` the policy opens egress to it: the Service's namespace for an in-cluster host, every address otherwise."
                        },
                        "headers": {
                            "type": "string",
                            "description": "OTLP headers (`OTEL_EXPORTER_OTLP_HEADERS`), e.g. `X-Scope-OrgID=giantswarm` for a multi-tenant collector."
                        },
                        "protocol": {
                            "type": "string",
                            "description": "OTLP protocol: `grpc` or `http/protobuf`.",
                            "enum": [
                                "grpc",
                                "http/protobuf"
                            ]
                        },
                        "resourceAttributes": {
                            "type": "string",
                            "description": "Resource attributes appended to the downward-API `k8s.pod.name`, `k8s.namespace.name` and `k8s.node.name`."
                        },
                        "sampler": {
                            "type": "string",
                            "description": "`OTEL_TRACES_SAMPLER`. The parent-based default follows the caller's sampling decision and samples `samplerArg` of the traces that start here."
                        },
                        "samplerArg": {
                            "type": "string",
                            "description": "`OTEL_TRACES_SAMPLER_ARG`."
                        }
                    }
                }
            }
        },
        "podAnnotations": {
            "type": "object",
            "description": "Annotations on the pod.",
            "additionalProperties": true
        },
        "podLabels": {
            "type": "object",
            "description": "Labels on the pod.",
            "additionalProperties": true
        },
        "podSecurityContext": {
            "type": "object",
            "description": "Pod security context.",
            "additionalProperties": false,
            "properties": {
                "fsGroup": {
                    "type": "integer"
                },
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "provider": {
            "type": "string"
        },
        "rbac": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "create": {
                    "type": "boolean",
                    "description": "Create the ServiceAccount's Role and RoleBinding in `workspaces.namespace`. The Role carries no rules yet: requests act as the caller, and the server's own work (volumes, sync jobs, snapshots) brings its rules with it."
                }
            }
        },
        "replicaCount": {
            "type": "integer",
            "description": "Number of replicas. The server keeps no MCP session state (a session begun on one replica continues on another) and acts as the caller, so two or more are fine. Tokens issued by its own OAuth flow (a client that signs in to it directly) live in one replica's memory; muster's forwarded Dex tokens are validated by every replica."
        },
        "resources": {
            "type": "object",
            "description": "Container resources.",
            "additionalProperties": false,
            "properties": {
                "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "ephemeral-storage": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "ephemeral-storage": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "revisionHistoryLimit": {
            "type": "integer",
            "description": "Number of old ReplicaSets retained for rollback."
        },
        "securityContext": {
            "type": "object",
            "description": "Container security context.",
            "additionalProperties": false,
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                },
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "service": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "type": "string",
                    "description": "Service type."
                },
                "port": {
                    "type": "integer",
                    "description": "Service port (the container listens on 8080)."
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "annotations": {
                    "type": "object",
                    "description": "Annotations on the ServiceAccount.",
                    "additionalProperties": true
                },
                "create": {
                    "type": "boolean",
                    "description": "Create a ServiceAccount."
                },
                "name": {
                    "type": "string",
                    "description": "ServiceAccount name (generated when empty)."
                }
            }
        },
        "serviceMonitor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Render a ServiceMonitor for the `metrics` port. Also needs `observability.metrics.enabled`."
                },
                "interval": {
                    "type": "string",
                    "description": "Scrape interval; empty uses the Prometheus Operator default."
                },
                "labels": {
                    "type": "object",
                    "description": "Labels on the ServiceMonitor, beside the chart's own. The Giant Swarm observability platform routes a scrape to a Mimir tenant by `observability.giantswarm.io/tenant`; a monitor without it writes to no tenant.",
                    "additionalProperties": true
                }
            }
        },
        "subscriptionID": {
            "type": "string"
        },
        "tolerations": {
            "type": "array",
            "description": "Tolerations.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "effect": {
                        "type": "string"
                    },
                    "key": {
                        "type": "string"
                    },
                    "operator": {
                        "type": "string"
                    },
                    "tolerationSeconds": {
                        "type": "integer"
                    },
                    "value": {
                        "type": "string"
                    }
                }
            }
        },
        "workspaces": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "namespace": {
                    "type": "string",
                    "description": "Namespace the workspaces, their volumes, snapshots and session grants live in: the namespace kagent runs its sessions in. The placeholder Role (`rbac.create`) is rendered here."
                }
            }
        }
    }
}
